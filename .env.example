# Secrets for agent-forge. This file is git-ignored; never commit it.

# Required: OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Optional: MongoDB Atlas connection string. Without it the assistant keeps task
# state in memory (lost on restart) and RAG / document questions won't work.
MONGODB_URI=

# Optional overrides
# MONGODB_VECTOR_INDEX=vector_index
# ASSISTANT_DB=assistant_db
# MONGODB_TLS_CA_FILE=
